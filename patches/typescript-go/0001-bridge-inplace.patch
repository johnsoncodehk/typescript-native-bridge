+// QueryCheckerSlots returns the number of query checker slots (MaxCheckers-1).
+// compiler.Program's whole-program diagnostics pass shards files into at most
+// this many deterministic groups so no slot ever serves two groups (issue #42).
+func (p *checkerPool) QueryCheckerSlots() int {
+	return p.opts.MaxCheckers - 1
+}
+
+// AssociateFiles records file→checker affinity for a currently leased query
+// checker. compiler.Program's whole-program diagnostics pass leases one
+// checker per stride group via GetChecker(nil), which names no file; without
+// this registration the pass leaves no affinity behind and the per-file
+// diagnostic RPCs that follow (build-mode getDiagnosticsBatch, declaration
+// emit) re-resolve every file on a cold checker instead of reacquiring the
+// warm one. Affinity never influences which checker checks which file during
+// the pass (the stride grouping decides that), so determinism is unaffected.
+func (p *checkerPool) AssociateFiles(c *checker.Checker, files []*ast.SourceFile) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	for index, existing := range p.checkers {
+		if existing == c {
+			for _, file := range files {
+				p.fileAssociations[file] = index
+			}
+			return
+		}
+	}
+}
